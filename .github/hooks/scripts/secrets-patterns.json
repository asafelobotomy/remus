{
  "version": 1,
  "patterns": [
    {"name": "AWS_ACCESS_KEY", "severity": "critical", "bash": "AKIA[0-9A-Z]{16}"},
    {"name": "PRIVATE_KEY", "severity": "critical", "bash": "-----BEGIN (RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----"},
    {"name": "GITHUB_PAT", "severity": "critical", "bash": "ghp_[0-9A-Za-z]{36}"},
    {"name": "GENERIC_SECRET", "severity": "high", "bash": "(secret|token|password|api[_-]?key|client[_-]?secret)[[:space:]]*[:=][[:space:]]*['" ]?[A-Za-z0-9_/+=~.-]{8,}"}
  ]
}
