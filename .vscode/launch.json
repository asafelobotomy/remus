{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug remus-cli",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/remus-cli",
      "args": [
        "--help"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cmake: build remus-cli (debug)",
      "env": {
        "QT_QPA_PLATFORM": "offscreen"
      }
    },
    {
      "name": "Debug remus-cli (--list)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/remus-cli",
      "args": [
        "--list"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cmake: build remus-cli (debug)",
      "env": {
        "QT_QPA_PLATFORM": "offscreen"
      }
    },
    {
      "name": "Debug remus-cli (scan ROMs)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/remus-cli",
      "args": [
        "--scan",
        "roms/NES",
        "--hash"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cmake: build remus-cli (debug)",
      "env": {
        "QT_QPA_PLATFORM": "offscreen"
      }
    },
    {
      "name": "Debug remus-cli (match)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/remus-cli",
      "args": [
        "--match",
        "--min-confidence",
        "70"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cmake: build remus-cli (debug)",
      "env": {
        "QT_QPA_PLATFORM": "offscreen"
      }
    },
    {
      "name": "Debug remus-cli (custom args)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/remus-cli",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cmake: build remus-cli (debug)",
      "env": {
        "QT_QPA_PLATFORM": "offscreen",
        "REMUS_CLI_ARGS": "${input:cliArgs}"
      },
      "initCommands": [
        "script import os, shlex; args = shlex.split(os.environ.get('REMUS_CLI_ARGS', '--help')); lldb.debugger.GetSelectedTarget().GetLaunchInfo().SetArguments(args, True)"
      ]
    },
    {
      "name": "Debug remus-gui",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/src/gui/remus-gui",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cmake: build remus-gui (debug)",
      "envFile": "${workspaceFolder}/.vscode/.env.debug"
    },
    {
      "name": "Debug Qt Test",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/tests/${input:testTarget}",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cmake: build test (debug)",
      "env": {
        "QT_QPA_PLATFORM": "offscreen"
      }
    }
  ],
  "inputs": [
    {
      "id": "cliArgs",
      "type": "promptString",
      "description": "remus-cli arguments (shell-style quoting supported, e.g. --scan \"roms/My Folder\" --hash)",
      "default": "--help"
    },
    {
      "id": "testTarget",
      "type": "promptString",
      "description": "Qt test binary name under build-debug/tests/",
      "default": "test_cli_helpers"
    }
  ]
}
