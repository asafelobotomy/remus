{
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "${userHome}/.npm"
      ]
    }
  },
  "servers": {
    "git": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "GIT_MCP_REPOSITORY": "${workspaceFolder}",
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv"
      },
      "args": [
        "--from",
        "mcp[cli]==1.27.1",
        "mcp",
        "run",
        "${workspaceFolder}/.github/mcp/scripts/gitMcp.py"
      ]
    },
    "github": {
      "type": "stdio",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "headers": {
        "X-MCP-Toolsets": "issues,pull_requests,actions,dependabot"
      },
      "disabled": true,
      "command": "uvx",
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv",
        "GITHUB_TOKEN": "${env:GITHUB_TOKEN}"
      },
      "args": [
        "--from",
        "mcp[cli]==1.27.1",
        "mcp",
        "run",
        "${workspaceFolder}/.github/mcp/scripts/githubMcp.py"
      ]
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv"
      },
      "args": [
        "--from",
        "mcp[cli]==1.27.1",
        "mcp",
        "run",
        "${workspaceFolder}/.github/mcp/scripts/sequentialThinkingMcp.py"
      ],
      "disabled": true
    },
    "xanadTools": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "mcp[cli]==1.27.1",
        "mcp",
        "run",
        "${workspaceFolder}/.github/mcp/scripts/xanadWorkspaceMcp.py"
      ],
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv"
      }
    },
    "web": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv"
      },
      "args": [
        "--with",
        "httpx",
        "--with",
        "markdownify",
        "--with",
        "beautifulsoup4",
        "--from",
        "mcp[cli]==1.27.1",
        "mcp",
        "run",
        "${workspaceFolder}/.github/mcp/scripts/webMcp.py"
      ]
    },
    "time": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv"
      },
      "args": [
        "--from",
        "mcp[cli]==1.27.1",
        "mcp",
        "run",
        "${workspaceFolder}/.github/mcp/scripts/timeMcp.py"
      ]
    },
    "security": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv"
      },
      "args": [
        "--from",
        "mcp[cli]==1.27.1",
        "mcp",
        "run",
        "${workspaceFolder}/.github/mcp/scripts/securityMcp.py"
      ]
    },
    "sqlite": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv"
      },
      "args": [
        "--from",
        "mcp[cli]==1.27.1",
        "mcp",
        "run",
        "${workspaceFolder}/.github/mcp/scripts/sqliteMcp.py"
      ],
      "disabled": true
    },
    "memory": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv",
        "WORKSPACE_ROOT": "${workspaceFolder}"
      },
      "args": [
        "--from",
        "mcp[cli]==1.27.1",
        "mcp",
        "run",
        "${workspaceFolder}/.github/mcp/scripts/memoryMcp.py"
      ]
    },
    "devDocs": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv"
      },
      "args": [
        "--with",
        "httpx",
        "--with",
        "beautifulsoup4",
        "--from",
        "mcp[cli]==1.27.1",
        "mcp",
        "run",
        "${workspaceFolder}/.github/mcp/scripts/devDocsMcp.py"
      ],
      "disabled": false
    },
    "filesystem": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv",
        "FS_ALLOWED_ROOT": "${workspaceFolder}"
      },
      "args": [
        "--from",
        "mcp[cli]==1.27.1",
        "mcp",
        "run",
        "${workspaceFolder}/.github/mcp/scripts/fsMcp.py"
      ]
    }
  }
}
