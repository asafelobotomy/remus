{
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "${userHome}/.npm"
      ]
    }
  },
  "servers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.1.14",
        "${workspaceFolder}"
      ],
      "sandboxEnabled": true,
      "sandbox": {
        "network": {
          "allowedDomains": [
            "registry.npmjs.org",
            "npmjs.org"
          ]
        },
        "filesystem": {
          "allowWrite": [
            "${workspaceFolder}",
            "${userHome}/.npm"
          ],
          "denyRead": [
            "${userHome}/.ssh",
            "${userHome}/.gnupg",
            "${userHome}/.aws",
            "${userHome}/.netrc",
            "${userHome}/.docker",
            "${userHome}/.kube",
            "${userHome}/.config",
            "${userHome}/.bash_history",
            "${userHome}/.zsh_history",
            "${userHome}/.local/share/keyrings"
          ]
        }
      }
    },
    "git": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "GIT_MCP_REPOSITORY": "${workspaceFolder}",
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv"
      },
      "args": [
        "--from",
        "mcp[cli]",
        "mcp",
        "run",
        "${workspaceFolder}/.github/hooks/scripts/gitMcp.py"
      ]
    },
    "github": {
      "type": "stdio",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "headers": {
        "X-MCP-Toolsets": "issues,pull_requests,actions,dependabot"
      },
      "disabled": true,
      "command": "uvx",
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv",
        "GITHUB_TOKEN": "${env:GITHUB_TOKEN}"
      },
      "args": [
        "--from",
        "mcp[cli]",
        "mcp",
        "run",
        "${workspaceFolder}/.github/hooks/scripts/githubMcp.py"
      ]
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv"
      },
      "args": [
        "--from",
        "mcp[cli]",
        "--with",
        "httpx==0.28.1",
        "--with",
        "beautifulsoup4==4.14.3",
        "mcp",
        "run",
        "${workspaceFolder}/.github/hooks/scripts/mcp-fetch-server.py"
      ],
      "disabled": true
    },
    "heartbeat": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "HEARTBEAT_WORKSPACE": "${workspaceFolder}",
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv/.copilot-tmp",
        "TMPDIR": "${userHome}/.cache/uv/.copilot-tmp"
      },
      "args": [
        "--from",
        "mcp[cli]",
        "mcp",
        "run",
        "${workspaceFolder}/.github/hooks/scripts/mcp-heartbeat-server.py"
      ]
    },
    "docs": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv"
      },
      "args": [
        "--from",
        "mcp[cli]",
        "--with",
        "httpx==0.28.1",
        "--with",
        "beautifulsoup4==4.14.3",
        "mcp",
        "run",
        "${workspaceFolder}/.github/hooks/scripts/mcp-docs-server.py"
      ],
      "disabled": true
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv"
      },
      "args": [
        "--from",
        "mcp[cli]",
        "mcp",
        "run",
        "${workspaceFolder}/.github/hooks/scripts/mcpSequentialThinkingServer.py"
      ],
      "disabled": true
    },
    "duckduckgo": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "mcp[cli]",
        "--with",
        "httpx==0.28.1",
        "--with",
        "beautifulsoup4==4.14.3",
        "mcp",
        "run",
        "${workspaceFolder}/.github/hooks/scripts/mcp-duckduckgo-server.py"
      ],
      "disabled": true
    },
    "xanadTools": {
      "type": "stdio",
      "command": "${workspaceFolder}/.github/hooks/scripts/xanadWorkspaceMcp.py",
      "args": []
    },
    "web": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv"
      },
      "args": [
        "--with",
        "httpx",
        "--with",
        "markdownify",
        "--with",
        "beautifulsoup4",
        "--from",
        "mcp[cli]",
        "mcp",
        "run",
        "${workspaceFolder}/.github/hooks/scripts/webMcp.py"
      ]
    },
    "time": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv"
      },
      "args": [
        "--from",
        "mcp[cli]",
        "mcp",
        "run",
        "${workspaceFolder}/.github/hooks/scripts/timeMcp.py"
      ]
    },
    "security": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv"
      },
      "args": [
        "--from",
        "mcp[cli]",
        "mcp",
        "run",
        "${workspaceFolder}/.github/hooks/scripts/securityMcp.py"
      ]
    },
    "sqlite": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "CLAUDE_TMPDIR": "${userHome}/.cache/uv",
        "TMPDIR": "${userHome}/.cache/uv"
      },
      "args": [
        "--from",
        "mcp[cli]",
        "mcp",
        "run",
        "${workspaceFolder}/.github/hooks/scripts/sqliteMcp.py"
      ],
      "disabled": true
    }
  }
}
