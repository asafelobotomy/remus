{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default",
      "description": "Workspace default preset for VS Code CMake Tools.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "REMUS_ENABLE_CXX20": "OFF",
        "REMUS_ENABLE_CCACHE": "ON",
        "REMUS_ENABLE_UNITY_BUILD": "OFF",
        "REMUS_ENABLE_PCH": "ON",
        "ENABLE_COVERAGE": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "displayName": "Default",
      "configurePreset": "default"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "displayName": "Default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}