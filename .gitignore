# Build artifacts
build/
build-*/
/build_output.txt
*.o
*.so
*.a
*.AppImage
*.AppDir
moc_*
qrc_*
ui_*

# Executables (test runners, CLI binaries at root level)
/test_parser
/remus-cli
*.exe

# Qt
*.pro.user
*.pro.user.*
.qmake.stash

# IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
.copilot/
.cursor/
.xanadAssistant/
*.swp
*.swo
*~

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Database
*.db
*.db-shm
*.db-wal
*.db.staged-*
*.sqlite
*.sqlite3

# Cache
cache/
*.cache
.cache/remus/
__pycache__/
.pytest_cache/
.mypy_cache/
*.pyc
*.pyo
*.pyd

# Logs
*.log
!test_output/attention.log
logs/

# OS
.DS_Store
Thumbs.db

# Credentials (never commit these!)
credentials.json
*.key
*.pem
.env
.env.*
.env.local
!.env.local.example
*.credentials
secrets.yml
.aws/credentials

# Test output (pipeline runs local-only; README and attention.log are tracked)
test_output/**
!test_output/README.md
!test_output/attention.log

# CTest output (generated by CMake/CTest runs — never commit)
Testing/**
!Testing/Temporary/
!Testing/Temporary/CTestCostData.txt

# Temporary working directories (pipeline test artefacts — never commit)
temp_*/
current_run_dir.txt

# Compendium build/runtime artefacts (generated — never commit)
data/compendium/*.lock
data/compendium/*.report.json
data/compendium/*.coverage.tsv
data/compendium/*.progress.json
data/compendium/compendium-manifest-full.json
data/compendium/enrichment-credentials.json

# Patch artefacts
*.orig
*.rej
*.patch

# Exported data (generated by --export command — never commit)
*-export.csv
*-export.json

# Test data
test_roms/
test_library/
rom_tests/

# Spurious workspace files (shell dotfiles / IDE configs / stray ROM files)
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc
/.gitconfig
/.ripgreprc
/.mcp.json
/.gitmodules
/.claude/
/.idea
# Stray ROM files at repo root
/Super Mario World*
/Super Metroid*

# Extracted ROM/game output directories (can appear anywhere)
**/extracted/

# Downloaded catalogue and enrichment data (update_dats.sh — never commit)
data/databases/**

# GameTDB XML databases (large, refreshed by update_dats.sh)
data/gametdb/*.xml

# Legacy downloaded metadata DATs (if raw DAT workflows are used manually)
data/metadata/

# OpenVGDB SQLite (downloaded by update_dats.sh — large binary, not tracked)
data/openvgdb/**

# MAME enrichment payloads (listxml ~300 MB; catver version-stamped)
data/mame/listxml.xml
data/mame/catver.ini

# Patch/hack DATs (synced from libretro metadat/hacks by update_dats.sh)
data/patches/**/*.dat
!data/patches/README.md

# Canonical local ROM storage (keep ROM payloads out of git)
/roms/**
!/roms/
!/roms/README.md

# Distribution/packaging
dist/

# ROM and game files (never commit ROMs)
# NOTE: Mega Drive ROMs use the .md extension — cannot blanket-ignore *.md
# since it conflicts with Markdown. Rely on directory-level ignores above.
