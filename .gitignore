# Build artifacts
build/
build-*/
/build_output.txt
*.o
*.so
*.a
*.AppImage
*.AppDir
moc_*
qrc_*
ui_*

# Executables (test runners, CLI binaries at root level)
/test_parser
/remus-cli
*.exe

# Qt
*.pro.user
*.pro.user.*
.qmake.stash

# IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/mcp.json
.idea/
*.swp
*.swo
*~

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Database
*.db
*.db-shm
*.db-wal
*.db.staged-*
*.sqlite
*.sqlite3

# Cache
cache/
*.cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Credentials (never commit these!)
credentials.json
*.key
*.pem
.env
.env.*
*.credentials
secrets.yml
.aws/credentials

# Test output (generated by integration/pipeline runs — never commit)
test_output/
!test_output/README.md

# Temporary working directories (pipeline test artefacts — never commit)
temp_*/
current_run_dir.txt

# Temporary task working directories (agent scratch space)
tmp_task/

# Copilot session runtime state (regenerated each session — never commit)
.copilot/workspace/runtime/
.copilot/workspace/.tmp/

# Exported data (generated by --export command — never commit)
*-export.csv
*-export.json

# Compendium runtime artefacts (generated during build/update — never commit)
data/compendium/*.lock
data/compendium/*.progress.json
data/compendium/*.report.json
data/compendium/enrichment-credentials.json

# Test data
test_roms/
test_library/
rom_tests/

# Spurious workspace files (shell dotfiles / IDE configs / stray ROM files)
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc
/.gitconfig
/.ripgreprc
/.mcp.json
/.gitmodules
/.claude/
/.idea
# Stray ROM files at repo root
/Super Mario World*
/Super Metroid*

# Extracted ROM/game output directories (can appear anywhere)
**/extracted/

# Legacy downloaded DAT databases (if raw DAT workflows are used manually)
data/databases/*.dat
data/databases/**/*.dat

# Legacy downloaded metadata DATs (if raw DAT workflows are used manually)
data/metadata/

# OpenVGDB SQLite (downloaded by update_dats.sh — large binary, not tracked)
data/openvgdb/*.sqlite

# Canonical local ROM storage (keep ROM payloads out of git)
/roms/**
!/roms/
!/roms/README.md

# Distribution/packaging
dist/

# ROM and game files (never commit ROMs)
# NOTE: Mega Drive ROMs use the .md extension — cannot blanket-ignore *.md
# since it conflicts with Markdown. Rely on directory-level ignores above.
## Nintendo
*.nes
*.fds
*.sfc
*.smc
*.snes
*.n64
*.v64
*.gbc
*.gba
*.gb
*.nds
*.3ds
*.cia
*.32x
*.smd
*.gen
*.gcm

## Sega
*.sms
*.gg
*.sg
*.bin

## Sony
*.psx
*.ps1
*.ps2
*.pbp
*.cso
*.chd

