# .env.local.example — copy to .env.local and fill in (never commit .env.local)
#
#   cp .env.local.example .env.local
#   $EDITOR .env.local
#
# Verify:
#   scripts/verify_credentials.sh
#   REMUS_RUN_LIVE_CREDENTIAL_TESTS=1 ctest --test-dir build -R CredentialsLiveTest
#
# Remus reads REMUS_* via CredentialManager (env → keychain → QSettings).
# build_compendium_full.sh and verify_credentials.sh auto-source .env.local.

# =============================================================================
# COMPENDIUM BUILD — recommended online tier (with keys below)
#   bash scripts/build_compendium_full.sh --skip-update --online-enrichment
#   Runs: offline DAT/metadata + bulk IGDB + bulk RetroAchievements (~2–3 h)
#
# OFFLINE ONLY (~90 min, no keys):
#   bash scripts/build_compendium_full.sh --skip-update
#
# FULL ONLINE BRIDGES (days on 200k+ games — avoid for full catalogues):
#   bash scripts/build_compendium_full.sh --skip-update --online-enrichment-all
# =============================================================================

# ── IGDB (Twitch) — compendium bulk + runtime metadata ───────────────────────
# Register: https://dev.twitch.tv/console/apps → "Register Your Application"
#   • Client type: Confidential (required for client secret)
#   • OAuth redirect URL: localhost (IGDB does not use the redirect)
# Auth: client_credentials → Remus caches the bearer token automatically
# Docs: https://api-docs.igdb.com/
export REMUS_IGDB_CLIENT_ID=""
export REMUS_IGDB_CLIENT_SECRET=""

# ── RetroAchievements — compendium bulk + runtime hash matching ──────────────
# Register: https://retroachievements.org/controlpanel.php → Keys → Web API key
# Both username and API key are required for Remus bulk enrichment.
# Docs: https://api-docs.retroachievements.org/getting-started.html
export REMUS_RA_USERNAME=""
export REMUS_RA_USER=""          # optional legacy alias for REMUS_RA_USERNAME
export REMUS_RA_API_KEY=""

# ── Hasheous — runtime + optional compendium (--online-enrichment-all) ───────
# Hash lookup (Lookup/ByHash): NO key required
# MetadataProxy (richer IGDB fields after hash match): key required
# Get key: https://hasheous.org/index.html?page=account
# Docs: https://hasheous.org/swagger/index.html
export REMUS_HASHEOUS_API_KEY=""
export REMUS_HASHEOUS_BASE_URL=""  # optional; default https://hasheous.org

# ── ScreenScraper — runtime only (NOT a compendium bulk pass) ────────────────
# 1. Account: https://www.screenscraper.fr/membreinscription.php
# 2. Developer API access (devid + devpassword):
#    https://www.screenscraper.fr/forumsujets.php?frub=12&numpage=0
# Remus sends devid, devpassword, ssid, sspassword on every API call.
export REMUS_SS_USER=""
export REMUS_SS_PASS=""
export REMUS_SS_DEVID=""
export REMUS_SS_DEVPASS=""

# ── TheGamesDB — runtime only (NOT a compendium bulk pass) ───────────────────
# Request project key: https://forums.thegamesdb.net/viewforum.php?f=10
# Retrieve key: https://api.thegamesdb.net/key.php
# API works without a key but is rate-limited; key recommended for regular use.
export REMUS_TGDB_API_KEY=""

# ── SteamGridDB — runtime artwork only (NOT a compendium bulk pass) ───────────
# Register: https://www.steamgriddb.com/profile/preferences/api
# Used for grids/heroes/logos when ScreenScraper/IGDB artwork is missing.
# Bridges via Steam app id (from IGDB external_games) or explicit steam:{appId} ids.
export REMUS_SGDB_API_KEY=""

# =============================================================================
# NO CREDENTIALS NEEDED (built into Remus)
# =============================================================================
# • PlayMatch — https://playmatch.retrorealm.dev (public instance, no auth)
# • Wikidata — SPARQL endpoint (no auth)
# • ZXInfo — https://api.zxinfo.dk/v3 (compendium pass; small ZX Spectrum set)
# • OpenVGDB / GameTDB / libretro metadata — local files via update_dats.sh

# =============================================================================
# OPTIONAL TOOLING (not provider API keys)
# =============================================================================
# RAHasher binary for disc-system RA MD5 (PS1/PS2/NDS/GC/Wii); see docs/metadata-providers.md
# export REMUS_RAHASHER_PATH="/usr/bin/rahasher"
# export REMUS_RAHASHER_SYSTEM_PATH="/usr/share/rahasher"

# Large temp space for CHD/hash extraction (default: system /tmp)
# export REMUS_TMPDIR="/mnt/scratch/remus-tmp"

# Enable live credential probes in CTest (after filling keys above)
# export REMUS_RUN_LIVE_CREDENTIAL_TESTS=1
